{
  "name": "deepseek-harness-ssh",
  "version": "0.4.3",
  "description": "Local DeepSeek Harness models with SSH remote folders and file tools",
  "type": "module",
  "license": "MIT",
  "author": "Snoyi Selew",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DevourerM/deepseek-harness-ssh.git"
  },
  "main": "lib/index.js",
  "icon": "assets/ssh.svg",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib",
    "assets",
    "docs",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "dependencies": {
    "ssh2": "1.17.0",
    "ws": "8.22.0"
  },
  "bundleDependencies": [
    "ssh2",
    "ws"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test test/*.test.mjs",
    "test:host": "node scripts/host-smoke.mjs",
    "test:ui": "node scripts/ui-smoke.mjs",
    "test:install": "node scripts/ui-install.mjs",
    "pack:plugin": "node scripts/build.mjs && node scripts/pack.mjs",
    "test:remote": "node scripts/local-workspace-smoke.mjs",
    "test:files": "node scripts/better-sidebar-smoke.mjs",
    "test:subagent": "node scripts/subagent-smoke.mjs",
    "test:terminal": "node scripts/terminal-smoke.mjs",
    "test:terminal-ui": "node scripts/terminal-ui-smoke.mjs",
    "test:channel-stress": "node scripts/channel-stress.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-fs": ">=0.2.0-rc.2 <0.3.0 || 0.2.1-rc.2 || 0.2.1-rc.3 || 0.2.1-rc.5 || 0.2.2-rc.1",
    "@deepseek-ai/dsh-tools": ">=0.2.0-rc.2 <0.3.0 || 0.2.1-rc.2 || 0.2.1-rc.3 || 0.2.1-rc.5 || 0.2.2-rc.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-fs": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  }
}
